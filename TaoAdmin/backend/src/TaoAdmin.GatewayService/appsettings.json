// ============================================================================
// TaoAdmin API 网关（GatewayService，端口 5000）配置
// 职责：统一入口、JWT 鉴权、限流、跨域、路由转发、TraceId 贯穿
// 前端所有请求都走网关，路径约定：/api/{服务段}/{业务路径}
// ============================================================================
{
  // 网关监听端口：前端 vite 代理与 Nginx 都指向这里
  // 【本地】5000；【线上】容器内 5000，由 Nginx/负载均衡对外暴露 80/443
  "Urls": "http://0.0.0.0:5000",

  // 【线上】建议改为具体域名
  "AllowedHosts": "*",

  // Elasticsearch 日志：【本地】留空只写本地文件；【线上】"http://elasticsearch:9200"
  "Elasticsearch": {
    "Uri": ""
  },

  "Jwt": {
    // 必须与各业务服务完全一致；★线上务必替换 SecretKey
    "SecretKey": "TaoAdmin@2024#SecretKey*MustBeLongEnough!",
    "Issuer": "TaoAdmin",
    "Audience": "TaoAdmin"
  },

  // Nacos：【线上】Enabled=true 后可按服务名负载均衡（Clusters 地址改由 Nacos 发现）
  "Nacos": {
    "Enabled": false,
    "ServerAddresses": [ "http://localhost:8848" ],
    "ServiceName": "taoadmin-gateway"
  },

  // ------------------------------------------------------------------------
  // 限流（固定窗口计数）：窗口内每个用户/IP 最多 PermitLimit 次请求，超了返回 429
  // 已登录按 UserId 分桶，未登录按 IP 分桶，互不影响
  // 【本地】100 次/10 秒；【线上】按网关压测容量调整，如 200 次/10 秒
  // ------------------------------------------------------------------------
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 10
  },

  // ------------------------------------------------------------------------
  // 熔断保护：下游微服务连续失败 FailureThreshold 次（5xx/连不上）即熔断，
  // 熔断期间网关直接返回 503 不再打下游，冷却 BreakSeconds 秒后半开探测
  // 统计粒度：路由前缀（identity / job / monitor 互相独立）
  // ------------------------------------------------------------------------
  "CircuitBreaker": {
    "Enabled": true,
    "FailureThreshold": 5,
    "BreakSeconds": 30
  },

  // ------------------------------------------------------------------------
  // YARP 反向代理路由：路径匹配 → 削前缀 → 转发到目标集群
  // 【本地】目标写 localhost；【线上】写服务名（docker compose 网络）
  //        如 "http://identity:5001/"；K8s 写 Service DNS：
  //        "http://taoadmin-identity.prod-svc:5001/"
  // ------------------------------------------------------------------------
  "ReverseProxy": {
    "Routes": {
      // /api/identity/** → 权限服务，削掉 /api/identity 前缀
      // 例：POST /api/identity/auth/login → 权限服务 POST /auth/login
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/identity/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/identity" } ]
      },
      // /api/job/** → 定时任务服务，削掉 /api/job 前缀
      // 例：GET /api/job/jobs → 任务服务 GET /jobs
      "job": {
        "ClusterId": "task",
        "Match": { "Path": "/api/job/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/job" } ]
      },
      // /api/monitor/** → 服务监控/日志（实现在权限服务里，只削 /api 保留 /monitor 段）
      // 例：GET /api/monitor/services → 权限服务 GET /monitor/services
      "monitor": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/monitor/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      // identity 集群：多实例时在 Destinations 里追加 d2、d3… 网关自动负载均衡
      "identity": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5001/" }
          // 【线上】"d1": { "Address": "http://identity:5001/" }
        }
      },
      "task": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5002/" }
          // 【线上】"d1": { "Address": "http://task:5002/" }
        }
      }
    }
  }
}
