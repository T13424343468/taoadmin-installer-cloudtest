// ============================================================================
// TaoAdmin 权限服务（IdentityService，端口 5001）配置
// ---------------------------------------------------------------------------
// .NET 配置文件支持 // 注释，启动时自动忽略。
// 线上覆盖配置的三种方式（优先级从高到低）：
//   1) 环境变量：  ConnectionStrings__MySql="server=...;pwd=..."
//   2) 环境分包：  appsettings.Production.json（随发布包携带，只写差异项）
//   3) Nacos 配置中心：Nacos.Enabled=true 后从 DataId=taoadmin-identity.yaml 拉取
// 【本地】= 开发机直跑；【线上】= Docker/K8s/生产服务器
// ============================================================================
{
  // 服务监听地址和端口
  // 【本地】http://0.0.0.0:5001（本机直跑）
  // 【线上】容器内保持 0.0.0.0，由外侧网关/Nginx 暴露，不直接对公网开放
  "Urls": "http://0.0.0.0:5001",

  // 允许的 Host 头；【线上】建议改为具体域名，如 "admin-api.example.com"
  "AllowedHosts": "*",

  "ConnectionStrings": {
    // MySQL 主库连接串（写操作、事务、建表迁移固定走这里）
    // 首次启动会 CodeFirst 自动建表并写入种子数据（含 admin 账号）
    // 【本地】server=127.0.0.1（开发机自己装的 MySQL）
    // 【线上】server=mysql（docker compose 服务名）或云数据库主库内网地址
    //         示例："server=mysql-master;port=3306;database=tao_admin;uid=taoadmin;pwd=线上强密码;charset=utf8mb4;SslMode=none;"
    // 安全提示：线上不要用 root，单独建账号并只授 tao_admin 库权限
    "MySql": "server=127.0.0.1;port=3306;database=tao_admin;uid=root;pwd=Micro@2026;charset=utf8mb4;SslMode=none;",

    // MySQL 从库连接串数组（只读，用于普通查询分流）
    // 【本地】留空 = 不启用读写分离，单库跑
    // 【线上】Enabled=true 时生效，示例（compose 部署 2 从库）：
    //         "Slaves": [
    //           "server=mysql-slave1;port=3306;database=tao_admin;uid=taoadmin;pwd=线上强密码;charset=utf8mb4;SslMode=none;",
    //           "server=mysql-slave2;port=3306;database=tao_admin;uid=taoadmin;pwd=线上强密码;charset=utf8mb4;SslMode=none;"
    //         ]
    //         使用云数据库（如 RDS 只读实例）时换成对应只读实例连接串
    "Slaves": [],

    // Redis：用于验证码、刷新令牌、分布式缓存
    // 【本地】localhost:6379
    // 【线上】"redis:6379,password=线上Redis密码,abortConnect=false"（compose 服务名或云 Redis）
    "Redis": "localhost:6379,abortConnect=false"
  },

  // 读写分离总开关：true 且 Slaves 非空时启用
  // 启用后：查询自动按权重分发到从库，写入/事务自动走主库；
  // 写后立即读的场景用 db.ForceMaster() 固定走主库（见 ReadWriteExtensions）
  // 【本地】false；【线上】true
  "ReadWriteSplitting": {
    "Enabled": false
  },

  // 多租户总开关：开启后实现 ITenantEntity 的表自动按当前租户过滤数据
  // 租户来源：请求头 X-Tenant-Id 优先，其次登录令牌 tenant_id 声明；平台层租户 0 不过滤
  // 【本地】true（体验租户隔离演示）；【线上】按业务需要开启
  "MultiTenant": {
    "Enabled": true
  },

  // 消息队列：Enabled=false 使用进程内内存队列（单机/开发，重启丢消息）；
  // true 切换 RabbitMQ（【线上】推荐，持久化 + 断线重连）
  // 【线上】HostName 填 compose 服务名 rabbitmq，账号密码务必改掉默认 guest
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },

  "Jwt": {
    // 签发方/受众，网关与各服务必须一致，否则验签失败
    "Issuer": "TaoAdmin",
    "Audience": "TaoAdmin",

    // JWT 签名密钥：至少 32 字符。★线上务必替换并妥善保管（密钥泄露=任何人可伪造登录）
    // 【线上】示例："请生成一条64位以上随机字符串作为生产密钥"
    // 建议用命令生成：openssl rand -base64 64
    "SecretKey": "TaoAdmin@2024#SecretKey*MustBeLongEnough!",

    // 登录令牌有效期（分钟）与刷新令牌有效期（天）
    "ExpireMinutes": 120,
    "RefreshExpireDays": 7
  },

  // 雪花 ID 机器分配：多实例部署时必须保证 DatacenterId+WorkerId 全局唯一
  // 【本地】单实例 1/1 即可；【线上】如 K8s 多副本，用环境变量注入序号：
  //         Snowflake__WorkerId=Pod 序号（0~31），Snowflake__DatacenterId=机房编号
  "Snowflake": {
    "DatacenterId": 1,
    "WorkerId": 1
  },

  // Elasticsearch 分布式日志：Serilog 直接写 ES，网关透传 TraceId 全链路追踪
  // 【本地】留空 = 不写 ES，日志只落本地文件（logs/ 目录）
  // 【线上】"Uri": "http://elasticsearch:9200"（compose 服务名）或 "http://10.0.1.100:9200"
  "Elasticsearch": {
    "Uri": ""
  },

  // Nacos 注册与配置中心（可选）
  // 【本地】Enabled=false，纯本地跑不需要
  // 【线上】Enabled=true 后：服务注册到 Nacos，网关可通过服务名做负载均衡；
  //         配置同时从 DataId=taoadmin-identity.yaml 读取
  // ServerAddresses 示例：【线上】"http://nacos:8848" 或集群 "http://nacos1:8848"
  "Nacos": {
    "Enabled": false,
    "ServerAddresses": [ "http://localhost:8848" ],
    "ServiceName": "taoadmin-identity",
    "GroupName": "DEFAULT_GROUP",
    "Namespace": "public",
    "RegisterEnabled": false
  },

  // 服务监控与本地日志
  // LogDir：本地文本日志目录（相对运行目录）；Services：服务监控中心探测的健康地址
  // 【线上】Services 里的地址换成容器网络地址，如 "http://gateway:5000"
  "Monitor": {
    "LogDir": "logs",
    "Services": {
      "gateway": "http://localhost:5000",
      "identity": "http://localhost:5001",
      "task": "http://localhost:5002"
    }
  }
}
