<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Product>TaoAdmin.Common</Product>
    <Company>Tao</Company>
    <Authors>Tao</Authors>
    <Copyright>Copyright (c) 2026 Tao</Copyright>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>TaoAdmin 通用库：雪花ID、Redis 缓存、SqlSugar 配置、JWT、权限授权、统一返回格式</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 引用 ASP.NET Core 框架，供权限授权 Handler / 基础控制器使用 HttpContext -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
      <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="RabbitMQ.Client" Version="7.0.0" />
    <PackageReference Include="SqlSugarCore" Version="5.1.4.221" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.35" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.Elasticsearch" Version="10.0.0" />
  </ItemGroup>

</Project>
