// ============================================================================
// TaoAdmin 定时任务服务（TaskService，端口 5002）配置
// Quartz 调度中心：任务定义存 MySQL，运行状态写 Redis 心跳
// 线上覆盖方式同权限服务：环境变量 > appsettings.Production.json > Nacos
// ============================================================================
{
  // 服务监听地址和端口
  // 【本地】http://0.0.0.0:5002；【线上】容器内不变，不直接对公网开放
  "Urls": "http://0.0.0.0:5002",

  // 【线上】建议改为具体域名
  "AllowedHosts": "*",

  "ConnectionStrings": {
    // MySQL 主库连接串（写操作、事务固定走这里）：任务定义（sys_job 表）持久化，与权限服务共用同一个库
    // 【本地】server=127.0.0.1；【线上】"server=mysql-master;port=3306;database=tao_admin;uid=taoadmin;pwd=线上强密码;..."
    "MySql": "server=127.0.0.1;port=3306;database=tao_admin;uid=root;pwd=Micro@2026;charset=utf8mb4;SslMode=none;",

    // MySQL 从库连接串数组（只读查询分流）
    // 【本地】留空 = 不启用；【线上】Enabled=true 时生效，示例：
    //         "Slaves": [ "server=mysql-slave1;port=3306;database=tao_admin;uid=taoadmin;pwd=线上强密码;charset=utf8mb4;SslMode=none;" ]
    "Slaves": [],

    // Redis：服务心跳（服务监控中心的存活判断）
    // 【线上】"redis:6379,password=线上Redis密码,abortConnect=false"
    "Redis": "localhost:6379,abortConnect=false"
  },

  // 读写分离总开关：true 且 Slaves 非空时启用（写/事务走主库，查询走从库）
  // 【本地】false；【线上】true
  "ReadWriteSplitting": {
    "Enabled": false
  },

  "Jwt": {
    // 与权限服务、网关保持一致（网关已验签，此处为直连场景兜底）
    // ★线上务必替换 SecretKey，三个服务同步替换
    "Issuer": "TaoAdmin",
    "Audience": "TaoAdmin",
    "SecretKey": "TaoAdmin@2024#SecretKey*MustBeLongEnough!",
    "ExpireMinutes": 120,
    "RefreshExpireDays": 7
  },

  // 雪花 ID：多实例部署时 WorkerId 必须与权限服务不同（这里用 2，权限服务用 1）
  // 【线上】K8s 多副本用环境变量注入：Snowflake__WorkerId=Pod 序号
  "Snowflake": {
    "DatacenterId": 1,
    "WorkerId": 2
  },

  // Elasticsearch 日志：【本地】留空只写本地文件；【线上】"http://elasticsearch:9200"
  "Elasticsearch": {
    "Uri": ""
  },

  // Nacos：【线上】Enabled=true；ServerAddresses 换成 "http://nacos:8848"
  "Nacos": {
    "Enabled": false,
    "ServerAddresses": [ "http://localhost:8848" ],
    "ServiceName": "taoadmin-task",
    "RegisterEnabled": false
  },

  // 本地文本日志目录（相对运行目录）；【线上】容器内建议挂载卷：-v ./task-logs:/app/logs
  "Monitor": {
    "LogDir": "logs"
  }
}
