<Window x:Class="TaoAdmin.Deployer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaoAdmin 一键部署器 v1.0" Height="580" Width="780"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Text="TaoAdmin 一键部署器" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- ============ Page: Home ============ -->
        <Grid Grid.Row="1" x:Name="PageHome">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="环境体检" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <ListBox Grid.Row="1" x:Name="EnvList" FontSize="14" Margin="0,0,0,12" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnDeploy" Style="{StaticResource BigButton}" Content="一键部署" Click="OnDeployClick"/>
                <Button x:Name="BtnCluster" Style="{StaticResource BigButton}" Content="分布式部署" Click="OnClusterClick"/>
                <Button x:Name="BtnUninstall" Style="{StaticResource BigButton}" Content="一键卸载" Click="OnUninstallClick"/>
                <Button x:Name="BtnStatus" Style="{StaticResource BigButton}" Content="查看状态" Click="OnStatusClick"/>
            </StackPanel>
        </Grid>

        <!-- ============ Page: Route ============ -->
        <Grid Grid.Row="1" x:Name="PageRoute" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="选择部署路线" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <StackPanel Grid.Row="1">
                <RadioButton x:Name="RouteNative" GroupName="route" FontSize="15" Margin="0,8" Padding="8">
                    <StackPanel>
                        <TextBlock Text="原生路线（推荐）—— 不用任何容器，装完即用" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="MySQL / Redis 直接以 Windows 进程运行，运行时全部装到部署目录，不污染系统，无需重启。" TextWrapping="Wrap" Foreground="#666" Margin="0,4,0,0"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="RouteDocker" GroupName="route" FontSize="15" Margin="0,8" Padding="8">
                    <StackPanel>
                        <TextBlock Text="容器路线 —— 用 Docker 编排全部 9 个服务" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="未安装 Docker Desktop 会自动安装（需要管理员权限，可能要求重启）。适合需要完整中间件（RabbitMQ/Nacos/ES）的场景。" TextWrapping="Wrap" Foreground="#666" Margin="0,4,0,0"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="上一步" Click="OnRouteBackClick"/>
                <Button x:Name="BtnStartDeploy" Style="{StaticResource PrimaryButton}" Content="开始部署" Click="OnStartDeployClick"/>
            </StackPanel>
        </Grid>

        <!-- ============ Page: Progress ============ -->
        <Grid Grid.Row="1" x:Name="PageProgress" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0" x:Name="OverallBar" Height="22" Minimum="0" Maximum="100"/>
                <TextBlock Grid.Column="1" x:Name="EtaText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="#666"/>
            </Grid>
            <ListBox Grid.Row="1" x:Name="StepList" Height="170" FontSize="14" Margin="0,0,0,8"/>
            <TextBox Grid.Row="2" x:Name="LogBox" FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     Background="#FAFAFA" BorderBrush="#DDD"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button x:Name="BtnCancel" Content="取消" Click="OnCancelClick"/>
                <Button x:Name="BtnOpenLogDir" Content="打开日志目录" Click="OnOpenLogDirClick"/>
            </StackPanel>
        </Grid>

        <!-- ============ Page: Done ============ -->
        <Grid Grid.Row="1" x:Name="PageDone" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="✅ 部署成功！" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1B9E4B"/>
                <TextBlock x:Name="DoneDetail" FontSize="15" Margin="0,20,0,0" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button x:Name="BtnOpenFrontend" Style="{StaticResource PrimaryButton}" Content="打开管理界面" Click="OnOpenFrontendClick"/>
                    <Button Content="回到主页" Click="OnHomeClick"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ============ Page: Failure ============ -->
        <Grid Grid.Row="1" x:Name="PageFail" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640">
                <TextBlock Text="⚠ 部署遇到问题" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#E5484D"/>
                <TextBlock x:Name="FailReason" FontSize="15" Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock x:Name="FailHint" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#666" TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button x:Name="BtnRetry" Style="{StaticResource PrimaryButton}" Content="重试" Click="OnRetryClick"/>
                    <Button Content="打开日志目录" Click="OnOpenLogDirClick"/>
                    <Button Content="回到主页" Click="OnHomeClick"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ============ Page: Cluster（分布式中控） ============ -->
        <Grid Grid.Row="1" x:Name="PageCluster" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 机器清单录入 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="分布式部署（中控）" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="ClusterNodeHost" Width="150" FontSize="14" Margin="0,0,8,0"
                             VerticalContentAlignment="Center" Tag="机器 IP"/>
                    <TextBox x:Name="ClusterNodeUser" Width="100" FontSize="14" Margin="0,0,8,0"
                             VerticalContentAlignment="Center" Text="root" Tag="SSH 账号"/>
                    <Button x:Name="BtnClusterAddNode" Content="添加机器" Click="OnClusterAddNodeClick" Margin="0,0,12,0"/>
                    <Button x:Name="BtnClusterStart" Style="{StaticResource PrimaryButton}" Content="并行安装" Click="OnClusterStartClick"/>
                    <Button x:Name="BtnClusterUpgrade" Content="滚动升级" Click="OnClusterUpgradeClick" Margin="12,0,0,0"/>
                    <Button Content="回到主页" Click="OnHomeClick" Margin="12,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="ClusterMatrixText" FontSize="13" Foreground="#666" Margin="0,6,0,0"
                           TextWrapping="Wrap" Text="添加机器后自动生成推荐布局（中间件→数据机、网关前端→边缘机、应用实例轮转均摊）。"/>
            </StackPanel>

            <!-- 整体进度 -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0" x:Name="ClusterOverallBar" Height="20" Minimum="0" Maximum="100"/>
                <TextBlock Grid.Column="1" x:Name="ClusterOverallText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="#666"/>
            </Grid>

            <!-- 机器×四阶段进度列表 -->
            <ListBox Grid.Row="2" x:Name="ClusterNodeList" FontSize="14" Margin="0,0,0,8"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnClusterLog" Content="打开日志目录" Click="OnOpenLogDirClick"/>
            </StackPanel>
        </Grid>

        <!-- ============ Page: Uninstall ============ -->
        <Grid Grid.Row="1" x:Name="PageUninstall" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="一键卸载" FontSize="18" FontWeight="Bold"/>
            <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="14" Margin="0,8,0,8"
                       Text="将停止全部服务，并删除：发布产物、运行时与数据库数据、前端依赖缓存、构建产物、断点状态。&#x0A;源码完整保留，不会被删除。"/>
            <CheckBox Grid.Row="2" x:Name="KeepRuntimesCheck" Content="保留已下载的运行时（重装更快）" FontSize="14"/>
            <TextBox Grid.Row="3" x:Name="UninstallLog" FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" Background="#FAFAFA" BorderBrush="#DDD" Margin="0,8,0,8"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnConfirmUninstall" Style="{StaticResource DangerButton}" Content="确认卸载" Click="OnConfirmUninstallClick"/>
                <Button Content="取消" Click="OnHomeClick"/>
            </StackPanel>
        </Grid>

        <!-- ============ Page: Status ============ -->
        <Grid Grid.Row="1" x:Name="PageStatus" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="服务状态" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="StatusRefreshTime" FontSize="13" Foreground="#666" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ListBox Grid.Row="2" x:Name="StatusList" FontSize="14" Margin="0,8,0,8"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="立即刷新" Click="OnStatusRefreshClick" Margin="0,0,12,0"/>
                <Button Content="回到主页" Click="OnHomeClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
